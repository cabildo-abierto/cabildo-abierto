generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(uuid()) @map("id")
  username     String @unique @map("username")
  email        String @unique @map("email")
  passwordHash String @map("password_hash")

  files File[]
  records  Record[]
  sessions Session[]

  @@map("user")
}

model Session {
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt DateTime @map("expires_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Topic {
  id    String @id @map("id")
  title String @unique @map("title")
  slug  String @unique @map("slug")

  comments    Comment[]
  blocks      Block[]
  edits       Edit[]
  connections TopicConnection[]
  redirects   TopicRedirect[]

  @@map("topic")
}

model TopicConnection {
  connectionId String   @id @default(uuid()) @map("connection_id")
  topicId      String   @map("topic_id")
  viewerId     String   @map("viewer_id")
  mode         String   @map("mode")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz()

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, expiresAt])
  @@index([topicId, mode, expiresAt])
  @@index([viewerId])
  @@map("topic_connection")
}

model Record {
  id String @id @map("id")

  typeId String @map("type_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  authorId  String   @map("author_id")

  author         User       @relation(fields: [authorId], references: [id])
  type           RecordType @relation(fields: [typeId], references: [id])
  comment        Comment?   @relation("CommentRecord")
  comments       Comment[]  @relation("CommentReplies")
  rootOfComments Comment[]  @relation("CommentRoot")
  reaction       Reaction?  @relation("ReactionRecord")
  reactions      Reaction[] @relation("ReactionSubject")
  edit           Edit?      @relation("EditRecord")

  deleted Boolean @default(false)

  @@map("record")
}

model RecordType {
  id   String @id @map("id")
  name String @map("name")

  records Record[]

  @@map("record_type")
}

model BlockVersion {
  id          String @id @default(uuid())
  topicId     String @map("topic_id")
  blockNumber String @map("block_number")

  document Document?

  content String @map("content")

  order String @map("order")

  editId String @map("edit_id")

  edit  Edit  @relation(fields: [editId, topicId], references: [id, topicId])
  block Block @relation(fields: [topicId, blockNumber], references: [topicId, blockNumber])

  deleted Boolean @default(false)

  @@unique([editId, blockNumber])
  @@index([topicId, blockNumber])
  @@map("block_version")
}

model Edit {
  id      String @id @map("id")
  topicId String @map("topic_id")

  blockVersions BlockVersion[]
  comments      Comment[]
  redirects     TopicRedirect[]

  message String?
  title   String? @map("title")

  topic  Topic  @relation(fields: [topicId], references: [id])
  record Record @relation("EditRecord", fields: [id], references: [id])

  @@unique([id, topicId])
  @@index([topicId])
  @@map("edit")
}

model TopicRedirect {
  slug    String @id @map("slug")
  topicId String @map("topic_id")
  editId  String @map("edit_id")

  topic Topic @relation(fields: [topicId], references: [id])
  edit  Edit  @relation(fields: [editId, topicId], references: [id, topicId], onDelete: Restrict)

  @@index([topicId])
  @@index([editId, topicId])
  @@map("topic_redirect")
}

model Block {
  topicId     String @map("topic_id")
  blockNumber String @map("block_number")

  typeId String    @map("type_id")
  type   BlockType @relation(fields: [typeId], references: [id])

  topic Topic @relation(fields: [topicId], references: [id])

  blockVersions BlockVersion[]
  comments      Comment[]

  @@id([topicId, blockNumber])
  @@map("block")
}

model BlockType {
  id   String @id @map("id")
  name String @map("name")

  blocks Block[]

  @@map("block_type")
}

model Comment {
  id            String @id @map("id")
  topicId       String @map("topic_id")
  commentNumber String @map("comment_number")

  rootId    String  @map("root_id")
  replyToId String  @map("reply_to_id")
  content   String  @map("content")
  editId    String? @map("edit_id")

  topic   Topic  @relation(fields: [topicId], references: [id])
  replyTo Record @relation("CommentReplies", fields: [replyToId], references: [id])
  record  Record @relation("CommentRecord", fields: [id], references: [id])
  root    Record @relation("CommentRoot", fields: [rootId], references: [id])
  edit    Edit?  @relation(fields: [editId, topicId], references: [id, topicId], onDelete: Restrict)

  blockNumber String? @map("block_number")
  block       Block?  @relation(fields: [blockNumber, topicId], references: [blockNumber, topicId], onDelete: Restrict)

  documentBlockId String? @map("document_block_id")
  documentBlock DocumentBlock? @relation(fields: [documentBlockId], references: [id], onDelete: Restrict)

  justifiesRejections Reaction[]

  @@index([documentBlockId])

  @@unique([topicId, commentNumber])
  @@index([replyToId])
  @@index([editId, topicId])
  @@map("comment")
}

model Reaction {
  id   String @id @map("id")
  type String @map("type")

  subjectId String @map("subject_id")
  subject   Record @relation("ReactionSubject", fields: [subjectId], references: [id])

  reasonId String?  @map("reason_id")
  reason   Comment? @relation(fields: [reasonId], references: [id])

  record Record @relation("ReactionRecord", fields: [id], references: [id])

  @@map("reaction")
}

model File {
  id String @id
  authorId String @map("author_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  name String
  bucket String
  key String @unique
  mime String
  size Int
  sha256 String
  author User @relation(fields: [authorId], references: [id])
  format String?
  previewFileId String? @map("preview_file_id")
  previewStatus String @default("ready") @map("preview_status")
  previewError String? @map("preview_error")
  previewFile File? @relation("FilePreview", fields: [previewFileId], references: [id])
  previewOf File[] @relation("FilePreview")
  documents Document[]
  blocks DocumentBlock[]
  @@map("file")
}

model Document {
  // Shared primary key makes a document belong to exactly one existing version.
  id String @id
  version BlockVersion @relation(fields: [id], references: [id], onDelete: Restrict)
  fileId String @map("file_id")
  title String
  description String
  file File @relation(fields: [fileId], references: [id])
  @@index([fileId])
  @@map("document")
}

model DocumentBlock {
  id String @id
  fileId String @map("file_id")
  position Int
  typeId String @map("type_id")
  content String
  file File @relation(fields: [fileId], references: [id])
  comments Comment[]
  @@unique([fileId, position])
  @@map("document_block")
}
