{
  "name": "cabildo-abierto",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:packages": "turbo run @cabildo-abierto/api#dev @cabildo-abierto/utils#dev @cabildo-abierto/editor-core#dev",
    "dev:web": "turbo run @cabildo-abierto/api#dev @cabildo-abierto/utils#dev @cabildo-abierto/editor-core#dev web#dev",
    "dev:backend": "turbo run @cabildo-abierto/api#dev @cabildo-abierto/utils#dev @cabildo-abierto/editor-core#dev backend#dev",
    "dev:worker": "turbo run @cabildo-abierto/api#dev @cabildo-abierto/utils#dev @cabildo-abierto/editor-core#dev backend#dev:worker",
    "dev:mirror": "turbo run @cabildo-abierto/api#dev @cabildo-abierto/utils#dev @cabildo-abierto/editor-core#dev backend#dev:mirror",
    "dev:worker-mirror": "turbo run @cabildo-abierto/api#dev @cabildo-abierto/utils#dev @cabildo-abierto/editor-core#dev backend#dev:worker-mirror",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "dependencies": {
    "turbo": "latest"
  },
  "pnpm": {
    "overrides": {
      "vite": "7.3.2"
    }
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.2",
    "turbo": "^2.6.3",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.44.1"
  }
}
