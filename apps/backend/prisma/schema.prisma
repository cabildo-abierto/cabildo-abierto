generator client {
  provider = "prisma-client-js"
}

generator kysely {
  provider = "prisma-kysely"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Record {
  uri              String    @id @unique
  cid              String?
  collection       String
  rkey             String
  authorId         String
  indexedAt        DateTime  @db.Timestamptz(3)
  createdAt        DateTime  @db.Timestamptz(3)
  trustedCreatedAt DateTime? @db.Timestamptz(3)

  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  deleted   Boolean  @default(false)

  record Json?

  consensus  Consensus?   @relation(fields: [consensusId], references: [id])
  comment    Comment?     @relation("comment")
  dataset    Dataset?
  reaction   Reaction?    @relation("Reaction_uriToRecord")
  hasReacted HasReacted[]
  polls      Poll[]

  notificationsGenerated Notification[]

  reactionsReceived Reaction[] @relation("Reaction_subjectIdToRecord")
  author            User       @relation("Record_authorIdToUser", fields: [authorId], references: [did])

  moderationProcesses RecordModerationProcess[]
  consensusId         String?
  consensusVersions   ConsensusVersion[]
  replies             Comment[]                 @relation("commentReply")
  rootOf              Comment[]                 @relation("commentRoot")
  contents            Content[]
  documents           Document[]
  topicVersions       TopicVersion[]

  @@index([authorId, collection, indexedAt(sort: Desc)])
  @@index([authorId, indexedAt(sort: Desc)])
  @@index([indexedAt(sort: Desc)])
}

model Blob {
  cid       String     @id
  authorId  String
  User      User       @relation(fields: [authorId], references: [did])
  Dataset   Dataset?
  documents Document[]

  @@index([authorId])
}

model Consensus {
  id                String             @id
  topicId           String
  topic             Topic              @relation(fields: [topicId], references: [id])
  currentVersionUri String             @unique
  currentVersion    ConsensusVersion   @relation("currentVersion", fields: [currentVersionUri], references: [uri])
  versions          ConsensusVersion[] @relation("consensusVersions")
  records           Record[]
  dataset           Dataset?           @relation(fields: [datasetUri], references: [uri])
  datasetUri        String?
}

model ConsensusVersion {
  uri    String @id
  record Record @relation(fields: [uri], references: [uri])

  consensusId String
  consensus   Consensus @relation("consensusVersions", fields: [consensusId], references: [id])

  currentVersionOf Consensus? @relation("currentVersion")

  title     String
  contentId String  @unique
  content   Content @relation(fields: [contentId], references: [id])

  createdAt DateTime @db.Timestamptz(3)
  labels    String[]
  eventDate DateTime @db.Date()
}

model Comment {
  uri       String   @id
  contentId String   @unique
  content   Content  @relation(fields: [contentId], references: [id])
  createdAt DateTime @db.Timestamptz(3)

  replyToId  String?
  replyToCid String?
  rootId     String?
  rootCid    String?

  record        Record? @relation("comment", fields: [uri], references: [uri])
  replyToRecord Record? @relation("commentReply", fields: [replyToId], references: [uri])
  rootRecord    Record? @relation("commentRoot", fields: [rootId], references: [uri])

  isChallenge Boolean @default(false)

  @@index([replyToId])
  @@index([rootId])
}

model Embed {
  id         String   @id @default(uuid())
  collection String
  value      Json
  contentId  String
  content    Content  @relation(fields: [contentId], references: [id])
  datasetUri String?
  dataset    Dataset? @relation(fields: [datasetUri], references: [uri])
}

model Content {
  id  String  @id @default(uuid())
  uri String?

  record           Record?           @relation(fields: [uri], references: [uri])
  consensusVersion ConsensusVersion?

  body    String
  facets  Json[]
  embeds  Embed[]
  comment Comment?
  drafts  Draft[]
}

model Document {
  uri       String   @id
  record    Record   @relation(fields: [uri], references: [uri])
  createdAt DateTime @db.Timestamptz(3)

  description String
  format      String

  url     String?
  blobCid String?
  blob    Blob?   @relation(fields: [blobCid], references: [cid])
}

model Dataset {
  uri         String   @id
  title       String
  description String?
  columns     String[]
  format      String?

  url String?

  blobCid String? @unique
  blob    Blob?   @relation(fields: [blobCid], references: [cid])

  record       Record      @relation(fields: [uri], references: [uri])
  usedInEmbeds Embed[]
  consensuses  Consensus[]
}

model Donation {
  id             String   @id
  userById       String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  transactionId  String?
  amount         Int
  mpPreferenceId String?  @unique
  User           User?    @relation(fields: [userById], references: [did])

  @@index([userById])
}

model Draft {
  id            String   @id
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  lastUpdatedAt DateTime @default(now()) @db.Timestamptz(3)
  authorId      String
  collection    String

  title     String?
  contentId String?
  content   Content? @relation(fields: [contentId], references: [id])

  author User @relation(fields: [authorId], references: [did])

  @@index([authorId])
}

model HasReacted {
  userId       String
  recordId     String
  reactionType String
  id           String @id
  Record       Record @relation(fields: [recordId], references: [uri])
  User         User   @relation(fields: [userId], references: [did])

  @@unique([userId, recordId, reactionType])
  @@index([recordId])
  @@index([reactionType, recordId, userId])
}

model InviteCode {
  code                                String    @id
  usedByDid                           String?   @unique
  usedAt                              DateTime? @db.Timestamptz(3)
  recommenderId                       String?
  createdAt                           DateTime  @default(now()) @db.Timestamptz(3)
  User_InviteCode_recommenderIdToUser User?     @relation("InviteCode_recommenderIdToUser", fields: [recommenderId], references: [did])
  User_InviteCode_usedByDidToUser     User?     @relation("InviteCode_usedByDidToUser", fields: [usedByDid], references: [did])
  pdsInvite                           String?

  uses Int @default(1)

  users InviteCodeUsedBy[]

  @@index([recommenderId])
  @@index([usedByDid])
}

model InviteCodeUsedBy {
  code    String
  codeRel InviteCode @relation(fields: [code], references: [code])

  userId String
  user   User   @relation(fields: [userId], references: [did])

  usedAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([code, userId])
}

model Notification {
  id               String           @id
  type             NotificationType
  userNotifiedId   String
  causedByRecordId String
  message          String?
  moreContext      String?
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  reasonSubject    String?
  Record           Record           @relation(fields: [causedByRecordId], references: [uri])
  User             User             @relation(fields: [userNotifiedId], references: [did])

  @@unique([causedByRecordId, userNotifiedId, type])
  @@index([userNotifiedId, createdAt(sort: Desc)])
}

model Reaction {
  uri String @id

  subjectId  String?
  subjectCid String?
  pollId     String?
  poll       Poll?   @relation(fields: [pollId], references: [id])

  label String

  createdAt DateTime @db.Timestamptz(3)

  subjectRecord Record? @relation("Reaction_subjectIdToRecord", fields: [subjectId], references: [uri])
  record        Record  @relation("Reaction_uriToRecord", fields: [uri], references: [uri])

  @@index([subjectId])
  @@index([uri, subjectId])
}

model Topic {
  id               String            @id
  currentVersionId String?           @unique
  currentVersion   TopicVersion?     @relation("Topic_currentVersionIdToTopicVersion", fields: [currentVersionId], references: [uri])
  category         TopicToCategory[]
  topicVersions    TopicVersion[]    @relation("TopicVersion_topicIdToTopic")
  consensus        Consensus[]
  polls            Poll[]
}

// categoría de temas, con sus links con otras categorías para el grafo
model TopicCategory {
  id              String            @id
  TopicToCategory TopicToCategory[]
  interestedUsers UserInterest[]    @relation("InterestedUsers")
}

// relación muchos a muchos entre temas y categorías
model TopicToCategory {
  topicId       String
  categoryId    String
  TopicCategory TopicCategory @relation(fields: [categoryId], references: [id])
  Topic         Topic         @relation(fields: [topicId], references: [id])

  @@id([topicId, categoryId])
}

model TopicProp {
  id              String       @id @default(uuid())
  topicVersionUri String
  topicVersion    TopicVersion @relation(fields: [topicVersionUri], references: [uri])
  name            String
  type            String
  stringValue     String?
  numberValue     Int?
  booleanValue    Boolean?
  stringListValue String[]
  datetimeValue   DateTime     @db.Timestamptz(3)
  dateValue       DateTime     @db.Date

  @@unique([topicVersionUri, name])
}

model TopicVersion {
  uri     String      @id
  topicId String
  props   TopicProp[]

  currentVersionOf Topic? @relation("Topic_currentVersionIdToTopicVersion")
  topic            Topic  @relation("TopicVersion_topicIdToTopic", fields: [topicId], references: [id])

  record Record @relation(fields: [uri], references: [uri])

  @@index([topicId])
}

model UserInterest {
  id              String        @id
  userId          String
  user            User          @relation("UserInterests", fields: [userId], references: [did])
  topicCategoryId String
  topicCategory   TopicCategory @relation("InterestedUsers", fields: [topicCategoryId], references: [id])

  @@unique([userId, topicCategoryId])
  @@index([userId])
  @@index([topicCategoryId])
}

model User {
  did    String  @id @db.VarChar(255)
  handle String?

  avatar      String?
  description String?
  displayName String?

  email           String?
  emailVerified   Boolean                  @default(false)
  mailingListSubs MailingListSubscription?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  hasAccess   Boolean   @default(false)
  dateOfBirth DateTime? @db.Date

  inCA               Boolean         @default(false)
  platformAdmin      Boolean         @default(false)
  orgValidation      String?
  userValidationHash String?         @unique
  moderationState    ModerationState @default(Ok)

  blobs              Blob[]
  donations          Donation[]
  drafts             Draft[]
  hasReacted         HasReacted[]
  invitesSent        InviteCode[]         @relation("InviteCode_recommenderIdToUser")
  inviteUsed         InviteCode?          @relation("InviteCode_usedByDidToUser")
  notifications      Notification[]
  records            Record[]             @relation("Record_authorIdToUser")
  validationRequests VerificationRequest?
  interests          UserInterest[]       @relation("UserInterests")

  moderationActions         ModerationAction[]
  resolvedModerationRecords RecordModerationProcess[]

  tokens Token[]

  codesUsed InviteCodeUsedBy[]

  events           Event[]
  userConfigValues UserConfigValue[]

  @@index([createdAt])
  @@index([did, inCA])
  @@index([handle])
  @@index([inCA, did])
}

model UserConfig {
  id               String            @id
  label            String
  userConfigValues UserConfigValue[]
  default          String
}

model UserConfigValue {
  id       String     @id
  value    String
  userId   String
  user     User       @relation(fields: [userId], references: [did])
  configId String
  config   UserConfig @relation(fields: [configId], references: [id])

  @@unique([configId, userId])
  @@index([userId, configId])
}

model VerificationRequest {
  id            String                    @id
  type          VerificationType
  userId        String                    @unique
  dniFrente     String?
  dniDorso      String?
  comentarios   String?
  documentacion String[]
  email         String?
  sitioWeb      String?
  tipoOrg       String?
  createdAt     DateTime                  @default(now()) @db.Timestamptz(3)
  rejectReason  String?
  result        VerificationRequestResult @default(Pendiente)
  User          User                      @relation(fields: [userId], references: [did])
}

model Timestamps {
  id   String   @id
  date DateTime @db.Timestamptz(3)
}

model EventType {
  id     String  @id
  name   String?
  events Event[]
}

model Event {
  id     String   @id
  date   DateTime @db.Timestamptz(3)
  userId String?
  user   User?    @relation(fields: [userId], references: [did])

  eventTypeId String
  eventType   EventType @relation(fields: [eventTypeId], references: [id])

  @@index([userId])
  @@index([eventTypeId])
  @@index([userId, eventTypeId])
}

model JobApplication {
  id        String   @id
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  name      String
  email     String
  comment   String
  cv        String?
  job       String
  seen      Boolean  @default(false)
}

enum MailingListSubscriptionStatus {
  Subscribed
  Unsubscribed
}

model MailingListSubscription {
  id            String                        @id @default(cuid())
  email         String                        @unique
  emailOriginal String?
  status        MailingListSubscriptionStatus @default(Subscribed)
  userId        String?                       @unique
  user          User?                         @relation(fields: [userId], references: [did])
  subscribedAt  DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime?                     @updatedAt @db.Timestamptz(3)
  emailsSent    EmailSent[]
}

model EmailSent {
  id          String                  @id @default(cuid())
  recipientId String
  recipient   MailingListSubscription @relation(fields: [recipientId], references: [id])
  sent_at     DateTime                @default(now()) @db.Timestamptz(3)
  text        String
  html        String
  subject     String
  success     Boolean
  from        String
  replyTo     String?
  templateId  String
  template    EmailTemplate           @relation(fields: [templateId], references: [id])

  @@index([recipientId])
}

model EmailTemplate {
  id         String      @id @default(cuid())
  name       String      @unique
  subject    String
  html       String
  text       String
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)
  emailsSent EmailSent[]
}

enum EditorStatus {
  Beginner
  Editor
  Administrator
}

enum ModerationState {
  Ok
  ShadowBan
}

enum NotificationType {
  Reply
  Mention
  TopicEdit
  TopicVersionVote
}

enum PromiseStatus {
  Pending
  Confirmed
  Payed
}

enum ReferenceType {
  Strong
  Weak
}

enum VerificationRequestResult {
  Aceptada
  Rechazada
  Pendiente
}

enum VerificationType {
  Persona
  Organizacion
}

enum Collection {
  ArCabildoabiertoFeedArticle
  AppBskyFeedPost
  AppBskyFeedRepost
}

model Stat {
  id    String   @id
  date  DateTime @db.Timestamptz(3)
  label String
  value Float

  @@index(date)
  @@index([label, date])
}

model ModerationAction {
  id             String               @id
  userAffectedId String
  userAffected   User                 @relation(fields: [userAffectedId], references: [did])
  type           ModerationActionType
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  dateStart      DateTime             @default(now()) @db.Timestamptz(3)
  dateEnd        DateTime?            @db.Timestamptz(3)

  @@index([userAffectedId])
}

enum ModerationActionType {
  MainFeedsSuspend // Se dejan de mostrar las publicaciones del usuario en los muros En discusión y Descubrir.
}

model RecordModerationProcess {
  id            String                   @id
  recordId      String?                  @unique
  record        Record?                  @relation(fields: [recordId], references: [uri])
  createdAt     DateTime                 @default(now()) @db.Timestamptz(3)
  processedAt   DateTime?                @db.Timestamptz(3)
  result        ContentModerationStatus?
  processedById String?
  processedBy   User?                    @relation(fields: [processedById], references: [did])
  method        ModerationMethod?

  @@index([recordId])
  @@index([processedById])
}

// una poll existe mientras haya al menos un embed o voto en el protocolo que la referencie
model Poll {
  id             String   @id
  description    String?
  choices        String[]
  createdAt      DateTime @db.Timestamptz(3)
  topicId        String?
  topic          Topic?   @relation(fields: [topicId], references: [id])
  parentRecordId String?
  parentRecord   Record?  @relation(fields: [parentRecordId], references: [uri])

  votes Reaction[]
}

model Token {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [did], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  action    String

  @@index([userId])
  @@index([token])
}

enum ModerationMethod {
  Manual
  Automatic
}

enum ContentModerationStatus {
  Ok
  MainFeedsSuspend
}
