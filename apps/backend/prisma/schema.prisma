generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(uuid()) @map("id")
  username     String @unique @map("username")
  email        String @unique @map("email")
  passwordHash String @map("password_hash")

  records  Record[]
  sessions Session[]

  @@map("user")
}

model Session {
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt DateTime @map("expires_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Topic {
  id    String @id @map("id")
  title String @unique @map("title")

  blocks   Block[]
  comments Comment[]
  records  Record[]

  @@map("topic")
}

model Record {
  id      String @id @map("id")
  topicId String @map("topic_id")

  typeId String @map("type_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  authorId  String   @map("author_id")

  author    User       @relation(fields: [authorId], references: [id])
  topic     Topic      @relation(fields: [topicId], references: [id])
  type      RecordType @relation(fields: [typeId], references: [id])
  blocks    Block[]
  comment   Comment?   @relation("CommentRecord")
  comments  Comment[]  @relation("CommentReplies")
  reaction  Reaction?  @relation("ReactionRecord")
  reactions Reaction[] @relation("ReactionSubject")

  @@map("record")
}

model RecordType {
  id   String @id @map("id")
  name String @map("name")

  records Record[]

  @@map("record_type")
}

model Block {
  id          String @id @map("id")
  topicId     String @map("topic_id")
  blockNumber String @map("block_number")

  typeId  String  @map("type_id")
  content String? @map("content")

  topic  Topic     @relation(fields: [topicId], references: [id])
  record Record    @relation(fields: [id], references: [id])
  type   BlockType @relation(fields: [typeId], references: [id])

  @@unique([topicId, blockNumber])
  @@map("block")
}

model BlockType {
  id   String @id @map("id")
  name String @map("name")

  blocks Block[]

  @@map("block_type")
}

model Comment {
  id            String @id @map("id")
  topicId       String @map("topic_id")
  commentNumber String @map("comment_number")

  replyToId String @map("reply_to_id")
  content   String @map("content")

  topic   Topic  @relation(fields: [topicId], references: [id])
  replyTo Record @relation("CommentReplies", fields: [replyToId], references: [id])
  record  Record @relation("CommentRecord", fields: [id], references: [id])

  justifiesRejections Reaction[]

  @@unique([topicId, commentNumber])
  @@map("comment")
}

model Reaction {
  id   String @id @map("id")
  type String @map("type")

  subjectId String @map("subject_id")
  subject   Record @relation("ReactionSubject", fields: [subjectId], references: [id])

  reasonId String  @map("reason_id")
  reason   Comment @relation(fields: [reasonId], references: [id])

  record Record @relation("ReactionRecord", fields: [id], references: [id])

  @@map("reaction")
}
