{
  "lexicon": 1,
  "id": "ar.cabildoabierto.wiki.defs",
  "defs": {
    "voteView": {
      "type": "object",
      "required": [
        "uri",
        "cid",
        "author",
        "subject"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "cid": {
          "type": "string",
          "format": "cid"
        },
        "author": {
          "type": "ref",
          "ref": "ar.cabildoabierto.actor.defs#profileViewBasic"
        },
        "subject": {
          "type": "ref",
          "ref": "com.atproto.repo.strongRef"
        }
      }
    },
    "threadViewContent": {
      "type": "object",
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "type": "union",
          "refs": [
            "ar.cabildoabierto.wiki.comment#view",
            "app.bsky.feed.defs#notFoundPost",
            "app.bsky.feed.defs#blockedPost"
          ]
        },
        "parent": {
          "type": "union",
          "refs": [
            "#threadViewContent",
            "app.bsky.feed.defs#notFoundPost",
            "app.bsky.feed.defs#blockedPost"
          ]
        },
        "replies": {
          "type": "array",
          "items": {
            "type": "union",
            "refs": [
              "#threadViewContent",
              "app.bsky.feed.defs#notFoundPost",
              "app.bsky.feed.defs#blockedPost"
            ]
          }
        }
      }
    }
  }
}