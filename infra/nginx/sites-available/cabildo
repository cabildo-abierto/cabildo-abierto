# =====================================================================
# Cabildo Abierto - Nginx Reverse Proxy (Cloudflare Full Strict)
# =====================================================================


# Redirect all HTTP → HTTPS (Cloudflare will usually do this too)
server {
    listen 80;
    listen [::]:80;
    server_name cabildoabierto.ar api.cabildoabierto.ar test.cabildoabierto.ar test-api.cabildoabierto.ar docmost.cabildoabierto.ar;
    return 301 https://$host$request_uri;
}


# =====================================================================
# MAIN SITE → port 3000
# =====================================================================
server {

    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name cabildoabierto.ar;

    ssl_certificate     /etc/ssl/certs/cabildo-origin.pem;
    ssl_certificate_key /etc/ssl/private/cabildo-origin.key;

    location / { proxy_pass http://127.0.0.1:3000;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_set_header Connection "";
    }
}

# =====================================================================
# MAIN API → port 8080
# =====================================================================
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.cabildoabierto.ar;

    ssl_certificate     /etc/ssl/certs/cabildo-origin.pem;
    ssl_certificate_key /etc/ssl/private/cabildo-origin.key;

    location / {
        client_max_body_size 25m;
        proxy_pass http://127.0.0.1:8080;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_set_header Connection "";
    }
}

# =====================================================================
# TEST SITE + API → isolated Compose ports 3002/8082
# =====================================================================
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name test.cabildoabierto.ar;

    ssl_certificate     /etc/ssl/certs/cabildo-origin.pem;
    ssl_certificate_key /etc/ssl/private/cabildo-origin.key;

    # Garage S3 endpoint for production objects. Signed URLs keep their original path.
    location ~ ^/cabildoabierto-prod(?:/|$) {
        client_max_body_size 512m;
        proxy_pass http://127.0.0.1:3900;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "private, no-store" always;
        access_log off;
    }

    location = /api {
        return 308 /api/;
    }

    location /api/ {
        client_max_body_size 25m;
        proxy_pass http://127.0.0.1:8082/;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_set_header Connection "";
    }

    location / {
        proxy_pass http://127.0.0.1:3002;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_set_header Connection "";
    }
}

