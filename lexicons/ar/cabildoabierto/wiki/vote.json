{
    "lexicon": 1,
    "id": "ar.cabildoabierto.wiki.vote",
    "defs": {
      "main": {
        "type": "record",
        "key": "tid",
        "description": "Un voto sobre un consenso, fuente o comentario en la wiki.",
        "record": {
          "type": "object",
          "required": ["subject", "createdAt"],
          "properties": {
            "subject": {
              "type": "ref",
              "ref": "com.atproto.repo.strongRef"
            },
            "createdAt": {
              "type": "string",
              "format": "datetime"
            },
            "label": {
              "type": "ref",
              "ref": "#label"
            },
            "reason": {
              "type": "ref",
              "ref": "com.atproto.repo.strongRef"
            }
          }
        }
      },
      "label": {
        "type": "string",
        "knownValues": [
          "accept",
          "reject",
          "upvote",
          "downvote"
        ]
      }
    }
  }