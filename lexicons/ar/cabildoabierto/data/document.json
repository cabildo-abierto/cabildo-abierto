{
  "lexicon": 1,
  "id": "ar.cabildoabierto.data.document",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["name", "createdAt"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Client-declared timestamp when this post was originally created."
          },
          "blob": {
            "type": "blob"
          },
          "url": {
            "type": "string"
          },
          "format": {
            "type": "string"
          }
        }
      }
    }
  }
}