NODE_ENV=production
HOST=0.0.0.0
PORT=8080

PUBLIC_URL=https://dev.cabildoabierto.ar/api
FRONTEND_URL=https://dev.cabildoabierto.ar
COOKIE_SECRET=<generate-a-long-random-secret>
REGISTRATION_PASSWORD=<choose-the-shared-registration-password>
ADMIN_TOKEN=<generate-a-long-random-secret>

# Use Neon's pooled URL at runtime and its direct URL for Prisma migrations.
DATABASE_URL=<neon-pooled-connection-string>
DIRECT_URL=<neon-direct-connection-string>
MAX_CONNECTIONS=2

RUN_CRONS=false
MIRROR_EXTENDED_USERS=false
REQUIRE_INVITE_CODE=false
WORKER_CONCURRENCY=1
DEV_NAME=vultr-dev
SERVICE_NAME=api-dev

# These are currently required by backend env validation even when their
# integrations are not used by this stack.
MP_ACCESS_TOKEN=<unused-in-dev>
MP_WEBHOOK_KEY=<unused-in-dev>
PDS_PASSWORD=<unused-in-dev>
