{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "license": "MIT",
  "main": "dist/index.js",
  "files": [
    "dist",
    "public",
    "package.json",
    "schema"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "SERVICE_NAME=api tsx watch --clear-screen=false src/index.ts | pino-pretty",
    "dev:worker": "SERVICE_NAME=worker tsx watch --clear-screen=false src/worker.ts | pino-pretty",
    "dev:mirror": "SERVICE_NAME=mirror tsx watch --clear-screen=false src/mirror.ts | pino-pretty",
    "dev:worker-mirror": "SERVICE_NAME=worker-mirror tsx watch --clear-screen=false src/worker-mirror.ts | pino-pretty",
    "start": "SERVICE_NAME=api node  dist/index.js",
    "start:worker": "SERVICE_NAME=worker node  dist/worker.js",
    "start:mirror": "SERVICE_NAME=mirror node  dist/mirror.js",
    "start:worker-mirror": "SERVICE_NAME=worker-mirror node  dist/worker-mirror.js",
    "script": "tsx watch --clear-screen=false src/scripts/script.ts | pino-pretty",
    "script:once": "tsx src/scripts/script.ts | pino-pretty",
    "script:create-test-users": "tsx src/scripts/create-test-users.ts",
    "script:create-notification-examples": "tsx src/scripts/create-notification-examples.ts",
    "script:import-datos-gob-ar": "tsx src/scripts/import-datos-gob-ar.ts",
    "script:copy-r2-to-dev": "tsx src/scripts/copy-r2-to-dev.ts",
    "script:sync-ca-users": "tsx src/scripts/sync-ca-users.ts | pino-pretty",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist coverage",
    "test": "NODE_ENV=test vitest --pool=threads",
    "test:log": "NODE_ENV=test LOG_IN_TESTS=true vitest --pool=threads",
    "test:watch": "NODE_ENV=test vitest --watch",
    "test:bail": "NODE_ENV=test vitest --pool=threads --bail=1",
    "test:reset-db": "tsx watch --clear-screen=false src/scripts/reset-dev-db.ts | pino-pretty",
    "coverage": "NODE_ENV=test vitest run --coverage",
    "migrate": "tsx src/scripts/apply-migrations.ts",
    "search:reindex": "node dist/scripts/search-reindex.js",
    "datasets:httpfs": "node src/scripts/install-dataset-httpfs.mjs",
    "datasets:prepare": "tsx src/scripts/datasets-prepare.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@cabildo-abierto/utils": "workspace:*",
    "@duckdb/node-api": "1.5.5-r.5",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.4.2",
    "envalid": "^8.2.0",
    "express": "^5.2.1",
    "kysely": "^0.28.17",
    "morgan": "^1.12.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@cabildo-abierto/api": "workspace:*",
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "vite": "7.3.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  }
}
