NODE_ENV=production
HOST=0.0.0.0
PORT=8080

PUBLIC_URL=https://test.cabildoabierto.ar/api
FRONTEND_URL=https://test.cabildoabierto.ar
COOKIE_SECRET=<generate-a-long-random-secret>
ADMIN_TOKEN=<generate-a-long-random-secret>

# Use Neon's pooled URL at runtime. Enter the direct URL interactively when
# applying Prisma migrations from the local checkout.
DATABASE_URL=<neon-pooled-connection-string>
MAX_CONNECTIONS=2

RUN_CRONS=false
MIRROR_EXTENDED_USERS=false
REQUIRE_INVITE_CODE=false
WORKER_CONCURRENCY=1
DEV_NAME=vultr-dev
SERVICE_NAME=api-dev
