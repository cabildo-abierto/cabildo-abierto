    listen 443 ssl;
    server_name www.cabildoabierto.ar;

    ssl_certificate     /etc/ssl/certs/cabildo-origin.pem;
    ssl_certificate_key /etc/ssl/private/cabildo-origin.key;

    return 301 https://cabildoabierto.ar$request_uri;
}


# =====================================================================
# DOCMOST → port 3100
# =====================================================================
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name docmost.cabildoabierto.ar;

    ssl_certificate     /etc/ssl/certs/cabildo-origin.pem;
    ssl_certificate_key /etc/ssl/private/cabildo-origin.key;

    location / {
        proxy_pass http://127.0.0.1:3100;

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # 🔑 IMPORTANTE para websockets
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
