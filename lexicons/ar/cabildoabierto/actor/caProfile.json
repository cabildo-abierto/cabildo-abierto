{
  "lexicon": 1,
  "id": "ar.cabildoabierto.actor.caProfile",
  "defs": {
    "main": {
      "type": "record",
      "description": "Un perfil de Cabildo Abierto.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "properties": {
          "createdAt": { "type": "string", "format": "datetime" },
          "displayName": {
            "type": "string",
            "maxGraphemes": 64,
            "maxLength": 640
          },
          "description": {
            "type": "string",
            "maxGraphemes": 256,
            "maxLength": 2560
          },
          "avatar": {
            "type": "blob",
            "description": "Foto de perfil.",
            "accept": ["image/png", "image/jpeg"],
            "maxSize": 1000000
          }
        }
      }
    }
  }
}