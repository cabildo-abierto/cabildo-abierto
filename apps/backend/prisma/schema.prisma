generator client {
  provider = "prisma-client-js"
}

generator kysely {
  provider = "prisma-kysely"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String @id @default(uuid())
  username      String @unique
  email         String @unique
  password_hash String

  author  String
  records Record[]
}

model Topic {
  id    String @id
  title String

  blocks   Block[]
  comments Comment[]
  records  Record[]
}

model Record {
  id      String @id
  topicId String @map("topic_id")

  type String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  authorId  String   @map("author_id")

  author    User       @relation(fields: [authorId], references: [id])
  topic     Topic      @relation(fields: [topicId], references: [id])
  blocks    Block[]
  comment   Comment?   @relation("CommentRecord")
  comments  Comment[]  @relation("CommentReplies")
  reaction  Reaction?  @relation("ReactionRecord")
  reactions Reaction[] @relation("ReactionSubject")
}

model Block {
  id          String @id
  topicId     String @map("topic_id")
  blockNumber String @map("block_number")

  type    String
  content String?

  topic  Topic  @relation(fields: [topicId], references: [id])
  record Record @relation(fields: [id], references: [id])

  @@unique([topicId, blockNumber])
}

model Comment {
  id            String @id
  topicId       String @map("topic_id")
  commentNumber String @map("comment_number")

  replyToId String @map("reply_to_id")
  content   String

  topic   Topic  @relation(fields: [topicId], references: [id])
  replyTo Record @relation("CommentReplies", fields: [replyToId], references: [id])
  record  Record @relation("CommentRecord", fields: [id], references: [id])

  justifiesRejections Reaction[]

  @@unique([topicId, commentNumber])
}

model Reaction {
  id   String @id
  type String

  subjectId String
  subject   Record @relation("ReactionSubject", fields: [subjectId], references: [id])

  reasonId String
  reason   Comment @relation(fields: [reasonId], references: [id])

  record Record @relation("ReactionRecord", fields: [id], references: [id])
}
