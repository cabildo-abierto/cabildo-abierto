NODE_ENV=production
HOST=0.0.0.0
PORT=8080

PUBLIC_URL=https://test.cabildoabierto.ar/api
FRONTEND_URL=https://test.cabildoabierto.ar
COOKIE_SECRET=<generate-a-long-random-secret>
ADMIN_TOKEN=<generate-a-long-random-secret>

# The dev deployment shares the production database on the same Docker node.
# Reach it through the Docker network, using the cabildo_prod credentials.
DATABASE_URL=postgresql://cabildo_prod:<password>@cabildo-postgres:5432/cabildo_prod
DIRECT_URL=postgresql://cabildo_prod:<password>@cabildo-postgres:5432/cabildo_prod
MAX_CONNECTIONS=2

RUN_CRONS=false
MIRROR_EXTENDED_USERS=false
REQUIRE_INVITE_CODE=false
WORKER_CONCURRENCY=1
DEV_NAME=vultr-dev
SERVICE_NAME=api-dev

# Document storage (private Cloudflare R2 bucket)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET=
DOCUMENT_MAX_MB=25
DOCUMENT_TEXT_MAX_MB=5
LIBREOFFICE_PATH=libreoffice

# CSV datasets
DATASET_MAX_MB=10
DATASET_MAX_CELLS=200000
