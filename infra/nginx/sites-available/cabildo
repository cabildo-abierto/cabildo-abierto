# =====================================================================
# Cabildo Abierto - Nginx Reverse Proxy (Cloudflare Full Strict)
# =====================================================================


# Redirect all HTTP → HTTPS (Cloudflare will usually do this too)
server {
    listen 80;
    listen [::]:80;
    server_name cabildoabierto.ar api.cabildoabierto.ar test.cabildoabierto.ar test-api.cabildoabierto.ar docmost.cabildoabierto.ar;
    return 301 https://$host$request_uri;
}


# =====================================================================
# MAIN SITE → port 3000
# =====================================================================
server {

    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name cabildoabierto.ar;

    ssl_certificate     /etc/ssl/certs/cabildo-origin.pem;
    ssl_certificate_key /etc/ssl/private/cabildo-origin.key;

    location / { proxy_pass http://127.0.0.1:3000;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_set_header Connection "";
    }
}

