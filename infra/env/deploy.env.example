# Local deploy configuration. Copy to infra/env/deploy.env and fill in values.

DEPLOY_SERVER="deploy@<ip-o-host>"
CONTAINER_REGISTRY="<registry>/<namespace>"
CONTAINER_REGISTRY_USER="<registry-user>"
CONTAINER_REGISTRY_PASSWORD="<registry-token>"

# Vultr account API key, different from the registry login token. Used only
# to remove old image artifacts after a successful deployment.
VULTR_ACCOUNT_API_KEY="<vultr-account-api-key>"
REGISTRY_KEEP_ARTIFACTS=5

PROD_BACKEND_URL="https://api.cabildoabierto.ar"
TEST_BACKEND_URL="https://test-api.cabildoabierto.ar"
DEV_BACKEND_URL="https://test.cabildoabierto.ar/api"
DEV_FRONTEND_URL="https://test.cabildoabierto.ar"

# Optional.
# REMOTE_STACK_ROOT="/opt/cabildo"
# DEV_REMOTE_STACK_ROOT="/opt/cabildo-dev"
# MIGRATION_NETWORK="cabildo-dev_default" # Red del contenedor de PostgreSQL para deploys prod/test.
# SKIP_REGISTRY_CLEANUP=1
# SKIP_NODE_CLEANUP=1
# DOCKER_PRUNE_UNTIL="168h"
